{
  "name": "@usapeek/api",
  "version": "2.3.3",
  "private": true,
  "description": "Mercur and Medusa backend for usapeek.",
  "license": "MIT",
  "exports": {
    "./order-tracking-contracts": {
      "types": "./.mercur/order-tracking-contracts.d.ts"
    },
    "./customer-contracts": {
      "types": "./.mercur/customer-contracts.d.ts"
    },
    "./order-notification-contracts": {
      "types": "./.mercur/order-notification-contracts.d.ts"
    },
    "./shipping-contracts": {
      "types": "./.mercur/shipping-contracts.d.ts"
    },
    "./auth-contracts": {
      "types": "./.mercur/auth-contracts.d.ts"
    },
    "./finance-contracts": {
      "types": "./.mercur/finance-contracts.d.ts"
    },
    "./catalog-permission-contracts": {
      "types": "./.mercur/catalog-permission-contracts.d.ts"
    },
    "./catalog-management-contracts": {
      "types": "./.mercur/catalog-management-contracts.d.ts"
    },
    "./search-contracts": {
      "types": "./.mercur/search-contracts.d.ts"
    },
    "./_generated": {
      "types": "./.mercur/routes.d.ts"
    }
  },
  "scripts": {
    "tracking:contracts:generate": "node scripts/generate-order-tracking-contracts.cjs",
    "tracking:contracts:check": "node scripts/generate-order-tracking-contracts.cjs --check",
    "customers:contracts:generate": "node scripts/generate-customer-contracts.cjs",
    "customers:contracts:check": "node scripts/generate-customer-contracts.cjs --check",
    "orders:contracts:generate": "node scripts/generate-order-notification-contracts.cjs",
    "orders:contracts:check": "node scripts/generate-order-notification-contracts.cjs --check",
    "shipping:contracts:generate": "node scripts/generate-shipping-contracts.cjs",
    "shipping:contracts:check": "node scripts/generate-shipping-contracts.cjs --check",
    "catalog:contracts:generate": "node scripts/generate-catalog-permission-contracts.cjs",
    "catalog:contracts:check": "node scripts/generate-catalog-permission-contracts.cjs --check",
    "catalog-management:contracts:generate": "node scripts/generate-catalog-management-contracts.cjs",
    "catalog-management:contracts:check": "node scripts/generate-catalog-management-contracts.cjs --check",
    "auth:contracts:generate": "node scripts/generate-auth-contracts.cjs",
    "auth:contracts:check": "node scripts/generate-auth-contracts.cjs --check",
    "finance:contracts:generate": "node scripts/generate-finance-contracts.cjs",
    "finance:contracts:check": "node scripts/generate-finance-contracts.cjs --check",
    "search:contracts:generate": "node scripts/generate-search-contracts.cjs",
    "search:contracts:check": "node scripts/generate-search-contracts.cjs --check",
    "search:reindex": "medusa exec ./src/scripts/reindex-search.ts",
    "build": "medusa build",
    "build:deploy": "pnpm build && node scripts/prepare-deployment.cjs && cd .medusa/server && pnpm --lockfile-dir . install --prod --ignore-scripts && node -e \"for (const file of ['pnpm-lock.yaml', 'pnpm-workspace.yaml']) require('node:fs').rmSync(file, { force: true })\"",
    "start": "pnpm start:api",
    "start:api": "cross-env MEDUSA_WORKER_MODE=server medusa start --host 0.0.0.0",
    "start:worker": "cross-env MEDUSA_WORKER_MODE=worker medusa start --host 0.0.0.0",
    "dev": "cross-env MEDUSA_WORKER_MODE=shared medusa develop --host 0.0.0.0",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration:modules && pnpm test:integration:http",
    "test:unit": "jest --config jest.unit.config.cjs --runInBand --forceExit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "db:migrate": "medusa db:migrate",
    "predeploy": "pnpm db:migrate",
    "contracts:generate": "node scripts/generate-onboarding-contracts.cjs",
    "contracts:check": "node scripts/generate-onboarding-contracts.cjs --check"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/draft-order": "2.18.0",
    "@medusajs/file-s3": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/inventory": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@mercurjs/core": "2.3.3",
    "@mercurjs/payout-stripe-connect": "2.3.3",
    "@mercurjs/types": "2.3.3",
    "algoliasearch": "5.56.0",
    "cross-env": "10.1.0",
    "date-fns": "4.4.0",
    "http-proxy-middleware": "3.0.7",
    "ioredis": "5.11.1",
    "libphonenumber-js": "^1.13.12",
    "resend": "6.26.0",
    "stripe": "15.12.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.18.0",
    "@medusajs/test-utils": "2.18.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "24.13.3",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "9.39.5",
    "jest": "^29.7.0",
    "jiti": "2.7.0",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "5.4.21",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
