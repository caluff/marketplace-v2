{
  "name": "@marketplace-v2/api",
  "version": "2.3.3",
  "private": true,
  "description": "Mercur and Medusa backend for marketplace-v2.",
  "license": "MIT",
  "exports": {
    "./_generated": {
      "types": "./.mercur/routes.d.ts"
    }
  },
  "scripts": {
    "build": "medusa build",
    "build:deploy": "pnpm build && cd .medusa/server && pnpm --ignore-workspace --lockfile-dir . install --prod --ignore-scripts && node -e \"require('node:fs').rmSync('pnpm-lock.yaml', { force: true })\"",
    "start": "pnpm start:api",
    "start:api": "cross-env MEDUSA_WORKER_MODE=server medusa start --host 0.0.0.0",
    "start:worker": "cross-env MEDUSA_WORKER_MODE=worker medusa start --host 0.0.0.0",
    "dev": "cross-env MEDUSA_WORKER_MODE=shared medusa develop --host 0.0.0.0",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "db:migrate": "medusa db:migrate",
    "predeploy": "pnpm db:migrate"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/draft-order": "2.18.0",
    "@mercurjs/core": "2.3.3",
    "@mercurjs/types": "2.3.3",
    "cross-env": "10.1.0",
    "http-proxy-middleware": "3.0.7"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.18.0",
    "@medusajs/test-utils": "2.18.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "24.13.3",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "9.39.5",
    "jest": "^29.7.0",
    "jiti": "2.7.0",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "5.4.21",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
