{
  "name": "@usapeek/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Independent operator dashboard shell for usapeek.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 7000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 \"src/features/**/*.test.ts\" \"src/features/**/*.test.mjs\"",
    "test:finance": "tsx --test --test-concurrency=1 \"src/features/commissions/*.test.ts\"",
    "test:orders": "tsx --test --test-concurrency=1 \"src/features/orders/*.test.mjs\"",
    "test:account": "tsx --test --test-concurrency=1 src/features/account/profile-completion.test.ts"
  },
  "dependencies": {
    "@usapeek/order-reference": "workspace:*",
    "@usapeek/theme-sync": "workspace:*",
    "@usapeek/ui": "workspace:*",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/types": "2.18.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.40.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@usapeek/api": "workspace:*",
    "@usapeek/vendor-onboarding-contracts": "workspace:*",
    "@mercurjs/types": "2.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.0.0"
}
